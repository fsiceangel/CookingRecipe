{
  "$schema": "../recipe.schema.json",
  "id": "taro-paste-filling",
  "tags": [
    "dessert"
  ],
  "difficulty": 1,
  "videoLink": "https://www.youtube.com/watch?v=yhjTPI7s89w",
  "defaultLanguage": "cn",
  "ingredients": [
    {
      "id": "taro-1",
      "ingredient": "taro",
      "name": {
        "cn": "荔浦芋头",
        "en": "Taro",
        "fr": "Taro"
      },
      "amount": {
        "cn": "500克 (蒸熟后)",
        "en": "500g (steamed)",
        "fr": "500g (cuit à la vapeur)"
      }
    },
    {
      "id": "sugar-2",
      "ingredient": "sugar",
      "name": {
        "cn": "细砂糖",
        "en": "Caster Sugar",
        "fr": "Sucre en poudre"
      },
      "amount": {
        "cn": "75克",
        "en": "75g",
        "fr": "75g"
      }
    },
    {
      "id": "butter-3",
      "ingredient": "butter",
      "name": {
        "cn": "黄油",
        "en": "Butter",
        "fr": "Beurre"
      },
      "amount": {
        "cn": "25克",
        "en": "25g",
        "fr": "25g"
      }
    }
  ],
  "translations": {
    "cn": {
      "title": "芋泥馅",
      "steps": [
        "芋头去皮切块，上锅蒸30分钟。",
        "将蒸熟的芋头、细砂糖和黄油放入料理机中搅打至细腻。"
      ],
      "notes": [
        "可选的甜点馅料。"
      ]
    },
    "en": {
      "title": "Taro Paste Filling",
      "steps": [
        "Peel and chop the taro, then steam for 30 minutes.",
        "Place the steamed taro, caster sugar, and butter in a food processor and blend until smooth and delicate."
      ],
      "notes": [
        "Optional filling for desserts."
      ]
    },
    "fr": {
      "title": "Fourrage à la Pâte de Taro",
      "steps": [
        "Peler et couper le taro en morceaux, puis cuire à la vapeur pendant 30 minutes.",
        "Placer le taro cuit à la vapeur, le sucre en poudre et le beurre dans un robot culinaire et mixer jusqu'à l'obtention d'une consistance lisse et délicate."
      ],
      "notes": [
        "Fourrage facultatif pour les desserts."
      ]
    }
  }
}
